{
  "name": "heddle",
  "version": "0.1.0",
  "description": "Deterministic multi-agent orchestration: plain TypeScript scripts fan out LLM subagents; control flow is code, only the leaves are model-driven.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backends/anthropic": {
      "types": "./dist/backends/anthropic.d.ts",
      "default": "./dist/backends/anthropic.js"
    },
    "./judges/jev": {
      "types": "./dist/judges/jev.d.ts",
      "default": "./dist/judges/jev.js"
    },
    "./judges/llm": {
      "types": "./dist/judges/llm.d.ts",
      "default": "./dist/judges/llm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
